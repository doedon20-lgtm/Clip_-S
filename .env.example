# ============================================================
# Clip_ S
# Environment Configuration
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

CLIP_S_APP_NAME=Clip_ S
CLIP_S_VERSION=0.2.0
CLIP_S_ENVIRONMENT=development
CLIP_S_DEBUG=false

# Server
CLIP_S_HOST=0.0.0.0
CLIP_S_PORT=8020


# ------------------------------------------------------------
# Storage
# ------------------------------------------------------------

CLIP_S_DATA_DIR=data
CLIP_S_UPLOAD_DIR=data/uploads
CLIP_S_OUTPUT_DIR=data/outputs
CLIP_S_PROJECT_DIR=data/projects


# ------------------------------------------------------------
# Upload limits
# ------------------------------------------------------------

# Maximum uploaded video size in MB
CLIP_S_MAX_UPLOAD_SIZE_MB=2048

# Maximum normal request body in MB
CLIP_S_MAX_REQUEST_BODY_MB=10


# ------------------------------------------------------------
# Video processing
# ------------------------------------------------------------

CLIP_S_FFMPEG_BIN=ffmpeg
CLIP_S_FFPROBE_BIN=ffprobe

# Number of background processing workers
CLIP_S_MAX_WORKERS=2

# Default generated clip duration
CLIP_S_DEFAULT_CLIP_DURATION=30

# Maximum generated clip duration
CLIP_S_MAX_CLIP_DURATION=180


# ------------------------------------------------------------
# AI analysis
# ------------------------------------------------------------

# Clip_ S is designed for local AI first.
CLIP_S_AI_ENABLED=true
CLIP_S_AI_PROVIDER=local
CLIP_S_AI_MODEL=clip-s-local


# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------

CLIP_S_ALLOWED_ORIGINS=http://localhost:8020,http://127.0.0.1:8020


# ------------------------------------------------------------
# Security
# ------------------------------------------------------------

# Change this before production deployment.
CLIP_S_SECRET_KEY=change-this-to-a-long-random-secret
